rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : ''; }
    function isSuperAdmin() { return signedIn() && role() == 'SUPER_ADMIN'; }
    function isSchoolAdmin(schoolId) {
      return signedIn() && (isSuperAdmin() || (role() == 'ADMINISTRATOR' && request.auth.token.schoolId == schoolId));
    }
    function sameSchool(schoolId) {
      return signedIn() && (isSuperAdmin() || request.auth.token.schoolId == schoolId);
    }
    function classInSchool(classId, schoolId) {
      return exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.schoolId == schoolId &&
        get(/databases/$(database)/documents/classes/$(classId)).data.status != 'ARCHIVED';
    }
    function employeeAssigned(classId) {
      return role() != 'EMPLOYEE' ||
        (exists(/databases/$(database)/documents/classes/$(classId)) &&
         request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.employeeUids);
    }

    match /schools/{schoolId} {
      allow read: if isSuperAdmin() || (signedIn() && request.auth.token.schoolId == schoolId);
      allow create: if isSuperAdmin() && request.resource.data.keys().hasOnly(['name','address','status','createdAt','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() >= 2;
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    match /classes/{classId} {
      allow read: if sameSchool(resource.data.schoolId) && role() in ['SUPER_ADMIN','ADMINISTRATOR','EMPLOYEE'];
      allow create: if isSchoolAdmin(request.resource.data.schoolId) && request.resource.data.keys().hasOnly(['schoolId','name','status','employeeUids','createdAt','updatedAt']) && request.resource.data.name is string && request.resource.data.employeeUids is list;
      allow update: if isSchoolAdmin(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','status','employeeUids','updatedAt']);
      allow delete: if false;
    }

    match /students/{studentId} {
      allow read: if sameSchool(resource.data.schoolId) && role() in ['SUPER_ADMIN','ADMINISTRATOR','EMPLOYEE'];
      allow create: if isSchoolAdmin(request.resource.data.schoolId) && classInSchool(request.resource.data.classId, request.resource.data.schoolId) && request.resource.data.keys().hasOnly(['schoolId','classId','firstName','lastName','birthDate','status','parentUids','createdAt','updatedAt']) && request.resource.data.firstName is string && request.resource.data.lastName is string;
      allow update: if isSchoolAdmin(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId && (request.resource.data.classId == resource.data.classId || classInSchool(request.resource.data.classId, resource.data.schoolId)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classId','firstName','lastName','birthDate','status','updatedAt']);
      allow delete: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if sameSchool(resource.data.schoolId) && role() in ['SUPER_ADMIN','ADMINISTRATOR','EMPLOYEE'];
      allow create: if sameSchool(request.resource.data.schoolId) && role() in ['SUPER_ADMIN','ADMINISTRATOR','EMPLOYEE'] && classInSchool(request.resource.data.classId, request.resource.data.schoolId) && employeeAssigned(request.resource.data.classId) && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.schoolId == request.resource.data.schoolId && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.classId == request.resource.data.classId && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.status == 'ACTIVE' && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time && request.resource.data.status in ['PRESENT','ABSENT','LATE','EXCUSED','LEFT_EARLY'];
      allow update: if sameSchool(resource.data.schoolId) && role() in ['SUPER_ADMIN','ADMINISTRATOR','EMPLOYEE'] && employeeAssigned(resource.data.classId) && request.time < resource.data.createdAt + duration.value(5, 'h') && request.resource.data.schoolId == resource.data.schoolId && request.resource.data.classId == resource.data.classId && request.resource.data.studentId == resource.data.studentId && request.resource.data.date == resource.data.date && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reason','changeReason','updatedAt']) && request.resource.data.updatedAt == request.time && request.resource.data.status in ['PRESENT','ABSENT','LATE','EXCUSED','LEFT_EARLY'];
      allow delete: if false;
    }

    // Invitation documents: school-scoped visibility and constrained creation.
    // This only stores/displays invitations; it does NOT grant Firebase Auth roles.
    match /invitations/{inviteId} {
      allow read: if signedIn() && (isSuperAdmin() || request.auth.token.schoolId == resource.data.schoolId);
      allow create: if signedIn() &&
        (isSuperAdmin() || (role() == 'ADMINISTRATOR' && request.auth.token.schoolId == request.resource.data.schoolId)) &&
        request.resource.data.keys().hasOnly(['code','schoolId','role','classId','status','createdAt','expiresAt','createdBy']) &&
        request.resource.data.code == inviteId &&
        request.resource.data.code is string && request.resource.data.code.matches('^[0-9]{6}$') &&
        request.resource.data.status == 'NEW' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(24, 'h') &&
        request.resource.data.role in (isSuperAdmin() ? ['ADMINISTRATOR','EMPLOYEE'] : ['EMPLOYEE']) &&
        (request.resource.data.role == 'ADMINISTRATOR' ? request.resource.data.classId == null : classInSchool(request.resource.data.classId, request.resource.data.schoolId));
      allow update: if isSchoolAdmin(resource.data.schoolId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'REVOKED';
      allow delete: if isSuperAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'PENDING' && request.resource.data.status == 'PENDING_APPROVAL';
      allow update, delete: if isSuperAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
